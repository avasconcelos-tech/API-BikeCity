{
  "name": "api-estoque",
  "version": "1.0.0",
  "description": "API REST para gestão de estoque e rastreabilidade",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings back-end/src/server.js",
    "dev": "node --no-warnings --watch back-end/src/server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "format": "prettier --write front-end",
    "format:check": "prettier --check front-end"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "file-type": "^22.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supertest": "^7.1.0"
  }
}
